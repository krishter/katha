# Copy to deploy.env on the production box. Never commit deploy.env.
#
# Why this is separate from backend/.env: config.Settings declares
# `extra="forbid"`, so any key it does not know about — POSTGRES_USER, say —
# makes the backend raise a ValidationError at import and refuse to start.
# The database and backup containers therefore read their own file.
#
# THESE MUST AGREE WITH backend/.env's DATABASE_URL. It is the same database
# described twice, in two syntaxes:
#
#   deploy.env      POSTGRES_USER=katha  POSTGRES_PASSWORD=s3cret  POSTGRES_DB=katha
#   backend/.env    DATABASE_URL=postgresql+asyncpg://katha:s3cret@db:5432/katha
#                                                     ^^^^^ ^^^^^^  ^^     ^^^^^
# The host is `db` — the compose service name — not localhost. scripts/deploy.sh
# checks the two files agree before it will deploy.

# Postgres reads these ONLY when it initialises an empty data directory.
# Changing POSTGRES_PASSWORD later has no effect on an existing volume — the
# database keeps the old password, the backend starts failing authentication,
# and it reads like a connection problem rather than a config one. To
# genuinely rotate it, change it here AND run:
#   ALTER USER katha WITH PASSWORD '...';
POSTGRES_USER=katha
POSTGRES_PASSWORD=            # generate: openssl rand -base64 24
POSTGRES_DB=katha

# Nightly backup (scripts/backup.sh, run by the `backup` service).
#
# BACKUP_RETENTION_DAYS is a DPDP number, not an ops preference: a family
# who exercises deletion remains inside the stored dumps until they age out.
# Whatever this says, the privacy copy has to be able to state it.
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR_UTC=20            # 01:30 IST — off-peak for families
