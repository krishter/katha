# Copy to backend/.env and fill in values — never commit .env.
# The path matters: config.Settings reads `.env` relative to the
# working directory, and the backend runs from backend/.
DATABASE_URL=postgresql+asyncpg://katha:katha@localhost:5432/katha
ENVIRONMENT=development
LOG_LEVEL=info

# Phase 1
SARVAM_API_KEY=your_sarvam_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Phase 4 — WhatsApp / Twilio
WHATSAPP_ADAPTER=stub                          # "stub" for dev/test, "twilio" for real sends
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+917019058242  # production sender
TWILIO_MESSAGING_SERVICE_SID=            # production sender lives in a Messaging Service; blank uses the number
WEBHOOK_VERIFY_TOKEN=katha-webhook-verify

# Phase 4 — WhatsApp message template SIDs (filled in after Meta approval).
# Values are per-environment; copy the approved SIDs into your own .env.
# No spaces around "=" and no quotes — the value is taken literally, so
# `KEY= "HX..."` yields a SID with a leading space and quote characters.
TWILIO_TEMPLATE_SESSION_OPEN=
TWILIO_TEMPLATE_FOLLOWUP=
TWILIO_TEMPLATE_MEMORY_CARD=
TWILIO_TEMPLATE_PARENT_WELCOME=
TWILIO_TEMPLATE_PARENT_WELCOME_FOLLOWUP=

# The host baked into the memory-card template's media URL. Twilio only
# allows a variable after a fixed domain, so the approved template holds
# https://<this host>/{{1}} and the backend passes only the object key and
# its signing query as {{1}}. Must match the host presigned URLs are issued
# on: <AWS_S3_BUCKET>.s3.<AWS_S3_REGION>.amazonaws.com. For the current
# production bucket that is:
#   katha-media-500923064555-ap-south-1-an.s3.ap-south-1.amazonaws.com
TWILIO_TEMPLATE_MEDIA_HOST=

# Phase 4 — AWS S3 (Mumbai — DPDP Act data residency)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Per-environment, and deliberately blank. This said "katha-media", which
# is not a bucket that exists — the real one is named per environment. It
# is left empty rather than pre-filled with production's, because a dev
# environment copying this file and inheriting the production bucket would
# write test media into a pilot family's storage. An unset bucket fails
# immediately; a wrong one fails quietly in the worst direction.
#
# TWILIO_TEMPLATE_MEDIA_HOST above must agree with whatever this is set to:
# <AWS_S3_BUCKET>.s3.<AWS_S3_REGION>.amazonaws.com
AWS_S3_BUCKET=
AWS_S3_REGION=ap-south-1

# Phase 6 — Family dashboard auth
JWT_SECRET=                         # generate with: openssl rand -hex 32
JWT_EXPIRE_DAYS=7
MAGIC_LINK_EXPIRE_MINUTES=15
SES_FROM_EMAIL=noreply@katha.life   # must be verified in AWS SES
APP_BASE_URL=http://localhost:3000  # frontend origin; https://app.katha.life in production — also drives the CORS allow-list
SES_MOCK=true                       # true in dev — prints the magic link instead of emailing it

# This backend's own externally-reachable base URL. Twilio signs the exact
# URL it POSTs to, and behind a TLS-terminating proxy request.url reports
# the internal scheme (http), not the public one — so the signature check
# reconstructs the URL from this instead. It must match what Twilio calls
# character for character: https, no trailing slash. Get it wrong and every
# webhook 403s.
PUBLIC_BASE_URL=http://localhost:8000   # https://api.katha.life in production

# Domain the session cookie is scoped to. MUST stay empty in development:
# localhost cannot be domain-scoped, and localhost:3000 and localhost:8000
# already share a cookie jar because cookies ignore ports.
#
# In production app.katha.life and api.katha.life are different hostnames.
# The magic-link verify sets the cookie on api., so leaving this empty makes
# it host-only and invisible to app. — every family is redirected to the
# login page forever. validate_production_config refuses to boot without it.
COOKIE_DOMAIN=                          # .katha.life in production (leading dot)

# Cost to serve — docs/specs/COST_TO_SERVE.md. Prices are in core/pricing.py.
USD_INR_RATE=95.06                      # reporting only: converts Anthropic and Twilio USD to INR
# Meta category per approved template SID, as JSON, e.g.
#   {"HXaaa...":"utility","HXbbb...":"marketing"}
# Meta sets the category (and re-categorises templates), and bills by it. A
# template missing here is recorded as "unknown" and listed as unpriced.
META_TEMPLATE_CATEGORIES=
# C2: build Layer 3 (what Katha knows about her) once per session and reuse
# it. false rebuilds it every turn, as before. Rollback by env + restart.
LAYER3_FREEZE_PER_SESSION=true
# C1/C4: Claude models per call. Roll back either by setting it to
# claude-sonnet-4-6 and restarting.
LLM_DIALOGUE_MODEL=claude-sonnet-5-5
LLM_DIALOGUE_EFFORT=medium              # output_config.effort for dialogue: low or medium
LLM_EXTRACTION_MODEL=claude-haiku-5-5   # per-turn extraction, its retry, and entity extraction
LLM_EXTRACTION_EFFORT=low
# C3: cache the stable start of the dialogue system prompt.
PROMPT_CACHE_ENABLED=true
PROMPT_CACHE_TTL=1h                     # 5m or 1h; replies are minutes apart, so 1h
# C5: the parent starts every conversation. true restores the daily opener and
# 30-minute nudge (rejected by Meta outside the 24h window) — rollback only.
SCHEDULED_OPENER_ENABLED=false
# C6: Sarvam TTS model. bulbul:v4-flash only after the blind listening test
# (COST_TO_SERVE.md §10). Languages without a v4 voice stay on v3.
TTS_MODEL=bulbul:v3
# C7: shorten pauses longer than STT_MAX_PAUSE_SECONDS to 0.5 s before STT.
STT_TRIM_PAUSES=true
STT_MAX_PAUSE_SECONDS=1.0

# Operator metrics page — docs/specs/ADMIN_METRICS.md. Empty = the routes 404.
# Production refuses to boot if this is set and shorter than 32 characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=
# Comma-separated user_ids to leave out of every metric (self-trial accounts,
# rehearsal users), e.g. user_ab12cd34,user_ef56ab78
METRICS_EXCLUDED_USER_IDS=
