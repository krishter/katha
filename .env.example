# Copy to backend/.env and fill in values — never commit .env.
# The path matters: config.Settings reads `.env` relative to the
# working directory, and the backend runs from backend/.
DATABASE_URL=postgresql+asyncpg://katha:katha@localhost:5432/katha
ENVIRONMENT=development
LOG_LEVEL=info

# Phase 1
SARVAM_API_KEY=your_sarvam_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Phase 4 — WhatsApp / Twilio
WHATSAPP_ADAPTER=stub                          # "stub" for dev/test, "twilio" for real sends
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+917019058242  # production sender
TWILIO_MESSAGING_SERVICE_SID=            # production sender lives in a Messaging Service; blank uses the number
WEBHOOK_VERIFY_TOKEN=katha-webhook-verify

# Phase 4 — WhatsApp message template SIDs (filled in after Meta approval).
# Values are per-environment; copy the approved SIDs into your own .env.
# No spaces around "=" and no quotes — the value is taken literally, so
# `KEY= "HX..."` yields a SID with a leading space and quote characters.
TWILIO_TEMPLATE_SESSION_OPEN=
TWILIO_TEMPLATE_FOLLOWUP=
TWILIO_TEMPLATE_MEMORY_CARD=
TWILIO_TEMPLATE_PARENT_WELCOME=
TWILIO_TEMPLATE_PARENT_WELCOME_FOLLOWUP=

# Phase 4 — AWS S3 (Mumbai — DPDP Act data residency)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=katha-media
AWS_S3_REGION=ap-south-1

# Phase 6 — Family dashboard auth
JWT_SECRET=                         # generate with: openssl rand -hex 32
JWT_EXPIRE_DAYS=7
MAGIC_LINK_EXPIRE_MINUTES=15
SES_FROM_EMAIL=noreply@katha.life   # must be verified in AWS SES
APP_BASE_URL=http://localhost:3000  # frontend origin; https://app.katha.life in production — also drives the CORS allow-list
SES_MOCK=true                       # true in dev — prints the magic link instead of emailing it

# This backend's own externally-reachable base URL. Twilio signs the exact
# URL it POSTs to, and behind a TLS-terminating proxy request.url reports
# the internal scheme (http), not the public one — so the signature check
# reconstructs the URL from this instead. It must match what Twilio calls
# character for character: https, no trailing slash. Get it wrong and every
# webhook 403s.
PUBLIC_BASE_URL=http://localhost:8000   # https://api.katha.life in production

# Domain the session cookie is scoped to. MUST stay empty in development:
# localhost cannot be domain-scoped, and localhost:3000 and localhost:8000
# already share a cookie jar because cookies ignore ports.
#
# In production app.katha.life and api.katha.life are different hostnames.
# The magic-link verify sets the cookie on api., so leaving this empty makes
# it host-only and invisible to app. — every family is redirected to the
# login page forever. validate_production_config refuses to boot without it.
COOKIE_DOMAIN=                          # .katha.life in production (leading dot)
